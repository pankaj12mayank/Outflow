# Outflo Production Environment Variables
# Copy this to .env and update values

# ==================== APP ====================
APP_NAME=Outflo
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0

# ==================== SERVER ====================
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ==================== DATABASE ====================
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=outflo
POSTGRES_USER=outflo_user
POSTGRES_PASSWORD=change_me_strong_password

# MongoDB
MONGODB_URL=mongodb://localhost:27017/outflo
MONGODB_DB_NAME=outflo

# ==================== JWT ====================
JWT_SECRET_KEY=change_me_generate_strong_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== OAUTH ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.outflo.io/auth/google/callback

# ==================== EMAIL ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=Outflo <noreply@outflo.io>

# ==================== AI PROVIDERS ====================
# OpenAI
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxx

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ==================== SCRAPING ====================
SCRAPING_PROXY_URL=
SCRAPING_USER_AGENT=Mozilla/5.0 (compatible; OutfloBot/1.0)

# ==================== FRONTEND ====================
NEXT_PUBLIC_API_URL=https://api.outflo.io
NEXT_PUBLIC_APP_URL=https://app.outflo.io

# ==================== SECURITY ====================
CORS_ORIGINS=https://app.outflo.io,https://outflo.io
RATE_LIMIT_PER_MINUTE=100
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs

# ==================== STRIPE (Payments) ====================
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_ID_STARTER=price_xxxx
STRIPE_PRICE_ID_PRO=price_xxxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxxx

# ==================== SENTRY (Monitoring) ====================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ==================== REDIS (Caching) ====================
REDIS_URL=redis://localhost:6379/0