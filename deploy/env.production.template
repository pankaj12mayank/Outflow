# ===========================================
# OUTFLO — Production environment (copy to Render + Vercel)
# Generate secrets: run deploy/one-click-deploy.ps1
# ===========================================

# --- RENDER (Backend) ---
MONGO_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/outflo?retryWrites=true&w=majority
MONGO_DATABASE=outflo
SECRET_KEY=CHANGE_ME_32_CHARS_MIN
DEBUG=false
APP_ENV=production
APP_URL=https://YOUR-APP.vercel.app
CORS_ORIGINS=["https://YOUR-APP.vercel.app"]

SYSTEM_OWNER_EMAIL=admin@outflo.com
SYSTEM_OWNER_PASSWORD=CHANGE_STRONG_PASSWORD
SYSTEM_OWNER_JWT_SECRET=CHANGE_RANDOM_STRING

# AI — paid API (recommended for cloud; no Ollama on Render)
AI_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
# Azure OpenAI example:
# OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT
# AI_DEFAULT_MODEL=gpt-4o
# Anthropic alternative:
# AI_PROVIDER=anthropic
# AI_DEFAULT_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_API_KEY=sk-ant-...

# Email (Gmail app password or SendGrid SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# --- VERCEL (Frontend) ---
NEXT_PUBLIC_API_URL=https://outflo-api.onrender.com
NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app
