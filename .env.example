# ===========================================
# OUTFLO - ENVIRONMENT VARIABLES
# ===========================================

# Application
APP_ENV=development
APP_NAME=Outflo
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security - CHANGE THIS IN PRODUCTION!
SECRET_KEY=outflo-dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - Update these!
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/outflo
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
CORS_CREDENTIALS=true

# Ollama AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# Scraping
PLAYWRIGHT_BROWSERS_PATH=./browsers
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
SCRAPE_DELAY_MS=2000
SCRAPE_MAX_CONCURRENT=5
SCRAPE_RETRY_ATTEMPTS=3

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
EMAIL_DAILY_LIMIT=500
EMAIL_RATE_LIMIT_MS=3000

# Polling Intervals (ms)
POLLING_CAMPAIGNS=30000
POLLING_LEADS=15000
POLLING_EMAILS=10000
POLLING_TASKS=5000

# Storage
STORAGE_PATH=./storage
UPLOAD_MAX_SIZE_MB=10

# Frontend URL (for API responses)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000